{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    // No `rootDir`: the workspace packages are consumed as source from outside
    // this directory. Emit is handled by tsup, so tsc only ever type-checks.
    "outDir": "./dist",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@liveconsole-ops/types": ["../../packages/types/src/index.ts"],
      "@liveconsole-ops/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts", "tsup.config.ts"]
}
