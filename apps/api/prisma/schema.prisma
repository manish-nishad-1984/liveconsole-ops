// ============================================================================
// LiveConsole Ops — PostgreSQL schema
//
// Generic infrastructure (tenants, accounts, RBAC, sessions, audit trail,
// document numbering, settings) followed by the business models: masters (sites,
// expense categories), petty cash (cash entries, expenses), transport (rented
// vehicles and their rent payments) and file attachments.
//
// ---------------------------------------------------------------------------
// CONVENTIONS
//
//  * UUID primary keys everywhere (`@db.Uuid`).
//  * Multi-tenant: every tenant-owned table carries `organizationId`, is indexed
//    on it, and scopes its unique keys by it. `organizationId` is *always* read
//    from the authenticated session, never from a request body.
//  * Tables are snake_case plural (`@@map`); columns stay camelCase so Prisma
//    code and DTOs read identically.
//  * Soft delete is `deletedAt` + `isActive`. The audit trail is append-only and
//    has neither.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  // Production is Windows (IIS); "windows" keeps that engine in the build even
  // when the client is generated on a Linux CI runner.
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum PaymentMode {
  CASH
  UPI
  BANK
}

/// GIVEN: cash handed to an employee. RETURNED: unspent cash handed back.
enum CashEntryType {
  GIVEN
  RETURNED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

/// How a rented vehicle's rent is worked out.
enum RentBasis {
  /// rate × days on rent
  PER_DAY
  /// rate is the whole rent for the job / trip
  FIXED
}

/// Whose money paid a vehicle's rent.
enum RentPaymentSource {
  /// Paid by the office directly — no effect on any employee's petty cash.
  OFFICE
  /// Paid by an employee out of petty cash — becomes an expense for approval.
  PETTY_CASH
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  PASSWORD_RESET
  PERMISSION_CHANGE
  STATUS_CHANGE
  APPROVE
  REJECT
  EXPORT
  IMPORT
}

// ============================================================================
// Tenancy
// ============================================================================

/// The tenant root. Every other tenant-owned row hangs off this by
/// `organizationId`, which is the whole multi-tenancy boundary.
model Organization {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique
  name      String
  legalName String?

  email   String?
  phone   String?
  website String?
  logoUrl String?

  addressLine1 String?
  addressLine2 String?
  pincode      String?
  country      String  @default("India")

  currency             String @default("INR")
  timezone             String @default("Asia/Kolkata")
  fiscalYearStartMonth Int    @default(4)

  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  branches        Branch[]
  users           User[]
  roles           Role[]
  auditLogs       AuditLog[]
  companySettings CompanySetting[]
  numberSequences NumberSequence[]

  sites             Site[]
  expenseCategories ExpenseCategory[]
  cashEntries       CashEntry[]
  expenses          Expense[]
  attachments       Attachment[]
  vehicleRentals    VehicleRental[]
  rentPayments      VehicleRentPayment[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("organizations")
}

/// An optional second axis inside a tenant — office, site, region. Kept because
/// multi-location tenants are common and retrofitting it later means touching
/// every table that should have been scoped by it.
model Branch {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  code           String
  name           String

  addressLine1 String?
  pincode      String?
  phone        String?
  email        String?
  isHeadOffice Boolean @default(false)

  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("branches")
}

// ============================================================================
// Accounts
// ============================================================================

model User {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  branchId       String? @db.Uuid

  employeeCode String?
  fullName     String
  /// Optional — site staff often have no email and sign in by mobile instead. When
  /// present it is globally unique, because sign-in by email must identify exactly
  /// one account across the whole platform. Mobile uniqueness among live accounts
  /// is enforced by the users service (a departed employee's number may be reissued).
  email        String? @unique
  mobile       String?
  passwordHash String
  avatarUrl    String?
  designation  String?

  status       UserStatus @default(INVITED)
  /// Bypasses every permission check. Reserved for platform owner accounts.
  isSuperAdmin Boolean    @default(false)

  mustChangePassword Boolean @default(false)
  /// Bumped to invalidate every outstanding access and refresh token at once —
  /// forced sign-out with no blacklist to maintain.
  tokenVersion       Int     @default(1)

  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  reportsToId String? @db.Uuid

  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  reportsTo    User?        @relation("UserReportsTo", fields: [reportsToId], references: [id], onDelete: SetNull)
  subordinates User[]       @relation("UserReportsTo")

  roles               UserRole[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  cashEntries      CashEntry[]  @relation("CashEntryEmployee")
  cashEntriesByMe  CashEntry[]  @relation("CashEntryHandledBy")
  expenses         Expense[]    @relation("ExpenseEmployee")
  expensesReviewed Expense[]    @relation("ExpenseReviewedBy")
  attachments      Attachment[]

  vehicleRentals VehicleRental[]      @relation("VehicleRentalEmployee")
  rentPayments   VehicleRentPayment[] @relation("RentPaymentPaidBy")

  @@unique([organizationId, employeeCode])
  @@index([organizationId])
  @@index([branchId])
  @@index([organizationId, status])
  @@index([mobile])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

// ============================================================================
// RBAC
//
// Global `Permission` rows (one per catalog string in packages/types/src/rbac.ts)
// ↔ RolePermission ↔ tenant-scoped Role ↔ UserRole ↔ User. The TypeScript catalog
// is the source of truth; the seed script reconciles this table against it.
// ============================================================================

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  module      String
  action      String
  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model Role {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  slug           String
  description    String?
  /// Seeded roles cannot be renamed or deleted; their permission sets stay editable.
  isSystem       Boolean @default(false)

  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  users        UserRole[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  roleId String @db.Uuid

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ============================================================================
// Sessions & credentials
// ============================================================================

model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  /// SHA-256 of the token; the raw value never touches the database.
  tokenHash String @unique
  /// Rotation family — replay of a revoked member revokes the whole family.
  familyId  String @db.Uuid

  expiresAt         DateTime
  revokedAt         DateTime?
  revokedReason     String?
  replacedByTokenId String?   @db.Uuid
  userAgent         String?
  ipAddress         String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================================
// Audit trail — append-only, so no isActive/deletedAt
// ============================================================================

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String?     @db.Uuid
  action         AuditAction

  entityType  String
  entityId    String? @db.Uuid
  entityLabel String?

  oldValues     Json?
  newValues     Json?
  /// Names of the fields that actually changed, for cheap filtering.
  changedFields String[]

  actorId    String? @db.Uuid
  actorEmail String?
  ipAddress  String?
  userAgent  String?
  requestId  String?

  createdAt DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([organizationId, action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================================
// Settings & numbering
// ============================================================================

/// Per-tenant document numbering: `<prefix>/<fiscalYear>/<0001>`. The counter is
/// advanced inside the transaction that writes the document, so two documents
/// created in the same second cannot take the same number.
model NumberSequence {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  prefix         String
  fiscalYear     String
  nextValue      Int    @default(1)
  padTo          Int    @default(4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, prefix, fiscalYear])
  @@index([organizationId])
  @@map("number_sequences")
}

/// Tenant-scoped key/value settings. `scope` groups them for the settings screen.
model CompanySetting {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  key            String
  value          Json
  scope          String  @default("GENERAL")
  description    String?
  dataType       String  @default("string")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([organizationId, scope])
  @@map("company_settings")
}

/// Platform-wide settings, deliberately not tenant-scoped. `isInternal` marks the
/// ones a tenant administrator must never see or change.
model SystemSetting {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  value       Json
  scope       String  @default("GLOBAL")
  description String?
  isInternal  Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@index([scope])
  @@map("system_settings")
}

// ============================================================================
// Masters
// ============================================================================

/// A work site — where cash is spent and vehicles are sent.
model Site {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  location       String?
  clientName     String?
  notes          String?

  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cashEntries    CashEntry[]
  expenses       Expense[]
  vehicleRentals VehicleRental[]

  @@index([organizationId, isActive])
  @@map("sites")
}

model ExpenseCategory {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  description    String?
  sortOrder      Int     @default(0)

  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@index([organizationId, isActive])
  @@map("expense_categories")
}

// ============================================================================
// Petty cash
//
// An employee's balance = cash GIVEN − cash RETURNED − APPROVED expenses.
// PENDING expenses are shown alongside but do not move the balance until an
// administrator approves them. Amounts are Decimal(12,2), never floats.
// ============================================================================

model CashEntry {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  /// "CB/2026-27/0001", allocated from NumberSequence inside the write.
  entryNo        String
  type           CashEntryType @default(GIVEN)
  employeeId     String        @db.Uuid
  siteId         String?       @db.Uuid
  entryDate      DateTime      @db.Date
  amount         Decimal       @db.Decimal(12, 2)
  paymentMode    PaymentMode   @default(CASH)
  /// UPI transaction id / bank reference.
  referenceNo    String?
  notes          String?
  /// The administrator who handed over (or received back) the money.
  handledById    String        @db.Uuid

  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     User         @relation("CashEntryEmployee", fields: [employeeId], references: [id])
  handledBy    User         @relation("CashEntryHandledBy", fields: [handledById], references: [id])
  site         Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@unique([organizationId, entryNo])
  @@index([organizationId, employeeId])
  @@index([organizationId, entryDate])
  @@index([siteId])
  @@map("cash_entries")
}

model Expense {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  /// "EX/2026-27/0001"
  expenseNo      String
  employeeId     String      @db.Uuid
  /// Optional — not every expense belongs to one site (office, travel between sites).
  siteId         String?     @db.Uuid
  categoryId     String      @db.Uuid
  expenseDate    DateTime    @db.Date
  amount         Decimal     @db.Decimal(12, 2)
  /// How the employee paid the vendor.
  paymentMode    PaymentMode @default(CASH)
  paidTo         String?
  /// Free text the employee may add — shown as "Remark". Optional: the category
  /// already says what the money went on, so a note is only for the exceptions.
  description    String?

  status       ExpenseStatus @default(PENDING)
  reviewedById String?       @db.Uuid
  reviewedAt   DateTime?
  reviewNote   String?

  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     User                @relation("ExpenseEmployee", fields: [employeeId], references: [id])
  reviewedBy   User?               @relation("ExpenseReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  site         Site?               @relation(fields: [siteId], references: [id])
  category     ExpenseCategory     @relation(fields: [categoryId], references: [id])
  /// Set when the expense was created by a petty cash vehicle rent payment; the
  /// payment then owns its amount, date and deletion.
  rentPayment  VehicleRentPayment?

  @@unique([organizationId, expenseNo])
  @@index([organizationId, employeeId, status])
  @@index([organizationId, status])
  @@index([organizationId, expenseDate])
  @@index([siteId])
  @@index([categoryId])
  @@map("expenses")
}

// ============================================================================
// Transport
//
// Vehicles hired for a site. Rent due = (PER_DAY: rate × days on rent, counted to
// today while still on rent; FIXED: rate) + extra charges. Payments are recorded
// against the rental; one paid from petty cash also creates an Expense for the
// employee who paid, so it goes through approval and the ledger like any other.
// ============================================================================

model VehicleRental {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  /// "VR/2026-27/0001"
  rentalNo       String
  /// The employee in charge of the vehicle. They see this record.
  employeeId     String  @db.Uuid
  siteId         String? @db.Uuid

  vehicleType   String
  vehicleNumber String?
  /// Owner or agency the vehicle is hired from.
  vendorName    String
  vendorMobile  String?
  driverName    String?
  driverMobile  String?

  fromDate     DateTime  @db.Date
  /// Null while the vehicle is still on rent.
  toDate       DateTime? @db.Date
  rentBasis    RentBasis @default(PER_DAY)
  /// Per day for PER_DAY; the whole rent for FIXED.
  rate         Decimal   @db.Decimal(12, 2)
  /// Diesel, driver allowance, loading — added on top of the rent.
  extraCharges Decimal   @default(0) @db.Decimal(12, 2)
  notes        String?

  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     User                 @relation("VehicleRentalEmployee", fields: [employeeId], references: [id])
  site         Site?                @relation(fields: [siteId], references: [id], onDelete: SetNull)
  payments     VehicleRentPayment[]

  @@unique([organizationId, rentalNo])
  @@index([organizationId, employeeId])
  @@index([organizationId, fromDate])
  @@index([siteId])
  @@map("vehicle_rentals")
}

model VehicleRentPayment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  rentalId       String @db.Uuid

  paymentDate DateTime          @db.Date
  amount      Decimal           @db.Decimal(12, 2)
  paymentMode PaymentMode       @default(CASH)
  source      RentPaymentSource @default(OFFICE)
  /// Who handed over the money.
  paidById    String            @db.Uuid
  referenceNo String?
  notes       String?
  /// The petty cash expense this payment created (PETTY_CASH only).
  expenseId   String?           @unique @db.Uuid

  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rental       VehicleRental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  paidBy       User          @relation("RentPaymentPaidBy", fields: [paidById], references: [id])
  expense      Expense?      @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([rentalId])
  @@index([paidById])
  @@map("vehicle_rent_payments")
}

// ============================================================================
// Files
// ============================================================================

/// A stored file (receipt photo, bill PDF) attached to any record by
/// entityType + entityId. The bytes live on disk under UPLOAD_DIR; only the API
/// serves them, after checking the caller may see the owning record.
model Attachment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  entityType     String
  entityId       String @db.Uuid

  fileName     String
  storedName   String @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String @db.Uuid

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  @@index([organizationId, entityType, entityId])
  @@map("attachments")
}
