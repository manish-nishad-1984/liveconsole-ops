NODE_ENV=development
PORT=4100
API_PREFIX=/api/v1
LOG_LEVEL=info

# Percent-encode reserved characters in the password (@ -> %40).
# Behind PgBouncer (e.g. the live host on port 6432) append &pgbouncer=true.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_boilerplate?schema=public"

# Generate your own, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Access and refresh tokens are signed with different secrets on purpose: a leaked
# access secret must not be usable to mint refresh tokens.
JWT_ACCESS_SECRET="replace-me-with-a-random-string-of-at-least-32-characters"
JWT_REFRESH_SECRET="replace-me-with-a-different-random-string-of-32-plus-characters"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_TTL_LONG=30d
JWT_ISSUER=liveconsole-ops

# Comma-separate to allow more than one origin.
WEB_ORIGIN=http://localhost:5273
# COOKIE_DOMAIN=.example.com
COOKIE_SECURE=false

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BCRYPT_ROUNDS=12

# Consumed by `npm run db:seed`. There is no self-signup endpoint: a new
# organisation and its first administrator are created by running the seed.
SEED_ORG_CODE=DEMO
SEED_COMPANY_NAME="Demo Organization"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe@123
