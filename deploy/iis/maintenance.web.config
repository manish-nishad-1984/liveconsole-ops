<?xml version="1.0" encoding="utf-8"?>
<!-- Temporary root web.config used while files the Node process holds open (the
     Prisma engine) are replaced. Nothing is routed to iisnode, so the process exits
     and releases its file locks. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Maintenance" stopProcessing="true">
          <match url="^maintenance\.html$" negate="true" />
          <action type="Rewrite" url="maintenance.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
