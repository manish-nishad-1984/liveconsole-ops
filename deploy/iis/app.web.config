<?xml version="1.0" encoding="utf-8"?>
<!-- LiveConsole Ops — Node API under iisnode. Requests arrive here only via the
     "API to Node" rewrite in the root web.config. -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.cjs" verb="*" modules="iisnode" />
    </handlers>
    <iisnode
      node_env="production"
      enableXFF="true"
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="false"
      watchedFiles="web.config" />
  </system.webServer>
</configuration>
